// Approach B, part 1: standalone job, triggered manually whenever you're ready to promote.
// Rebuilds nothing - reads whatever image tag is currently live in dev for the chosen
// service, and promotes that exact, already-tested artifact to staging after approval.
pipeline {
  agent { kubernetes { yamlFile 'streaming-platform/jenkins/agent-pod.yaml' } }
  parameters {
    choice(name: 'SVC', choices: ['catalog-service', 'frontend', 'api-gateway', 'user-service', 'playback-service'],
           description: 'Which service to promote from dev to staging')
  }
  stages {
    stage('Checkout dev (source of promotion)') {
      steps {
        git url: 'https://github.com/kunalsakpal235/gke-netflix.git', branch: 'dev', credentialsId: 'github-pat'
      }
    }
    stage('Read current dev image tag') {
      steps { container('tools') {
        script {
          sh 'apk add --no-cache curl'
          sh 'curl -sL https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -o /usr/local/bin/yq && chmod +x /usr/local/bin/yq'
          env.PROMOTED_TAG = sh(script: "yq '(.services[] | select(.name == \"${params.SVC}\")).image.tag' streaming-platform/gitops/environments/dev/values.yaml", returnStdout: true).trim()
        }
        echo "Promoting ${params.SVC} tag: ${env.PROMOTED_TAG}"
      } }
    }
    stage('Approval') { steps { input message: "Promote ${params.SVC} (${env.PROMOTED_TAG}) from dev to staging?", ok: 'Promote' } }
    stage('Update staging + push') {
      steps { container('tools') {
        withCredentials([usernamePassword(credentialsId: 'github-pat', usernameVariable: 'U', passwordVariable: 'P')]) {
          sh """
            git config --global --add safe.directory "\$WORKSPACE"
            git config user.email ci@lab && git config user.name jenkins
            git fetch origin staging || true
            git checkout -B staging origin/staging 2>/dev/null || git checkout -B staging
            yq -i '(.services[] | select(.name == "${params.SVC}")).image.tag = "${env.PROMOTED_TAG}"' streaming-platform/gitops/environments/staging/values.yaml
            git commit -am "ci: promote ${params.SVC} ${env.PROMOTED_TAG} dev -> staging"
            git push https://\$U:\$P@github.com/kunalsakpal235/gke-netflix.git HEAD:staging
          """
        }
      } }
    }
    stage('ArgoCD sync & verify: staging') {
      steps { container('tools') {
        withCredentials([string(credentialsId: 'argocd-token', variable: 'ARGOCD_TOKEN')]) {
          sh '''
            curl -sL https://github.com/argoproj/argo-cd/releases/latest/download/argocd-linux-amd64 -o /usr/local/bin/argocd
            chmod +x /usr/local/bin/argocd
            argocd login argocd-server.argocd.svc.cluster.local --insecure --plaintext --auth-token "$ARGOCD_TOKEN"
            argocd app sync streaming-staging
            argocd app wait streaming-staging --health --timeout 300
          '''
        }
      } }
    }
  }
}
